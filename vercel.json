{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "laksub.vercel.app"
        }
      ],
      "destination": "https://laksub.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.laksub.com"
        }
      ],
      "destination": "https://laksub.com/:path*",
      "permanent": true
    }
  ]
}
